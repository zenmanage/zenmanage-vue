{
  "name": "@zenmanage/vue",
  "version": "1.0.0",
  "description": "Vue 3 plugin, composables and SSR helpers for Zenmanage feature flags",
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "vite",
    "composables",
    "ssr",
    "feature-flags",
    "feature-toggles",
    "feature-management",
    "remote-config",
    "ab-testing",
    "experiments",
    "zenmanage"
  ],
  "homepage": "https://github.com/zenmanage/zenmanage-vue#readme",
  "bugs": {
    "url": "https://github.com/zenmanage/zenmanage-vue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenmanage/zenmanage-vue.git"
  },
  "license": "MIT",
  "author": "Zenmanage",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"*.{md,json,yml,yaml,cjs}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\" \"*.{md,json,yml,yaml,cjs}\" \"docs/**/*.md\"",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "validate": "npm run format:check && npm run lint && npm run type-check && npm run test:coverage && npm run build && npm run test:smoke",
    "prepublishOnly": "npm run validate"
  },
  "peerDependencies": {
    "@zenmanage/sdk": "^3.5.1",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vue/test-utils": "^2.4.6",
    "@zenmanage/sdk": "^3.5.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.1",
    "jsdom": "^24.1.1",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "vitest": "^1.6.0",
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
